{
  "metadata": {
    "projectName": "DemoSat-TG",
    "version": "1.0.0",
    "description": "Arquitetura conceitual de um satélite de observação da Terra para demonstrar relações sistêmicas em 2D e 3D."
  },
  "mission": {
    "id": "mission_demosat",
    "name": "Missão DemoSat-TG — Observação da Terra",
    "objectives": [
      "Coletar imagens multiespectrais de regiões de interesse.",
      "Transmitir dados de missão para a estação solo.",
      "Manter operação nominal em órbita baixa por 5 anos."
    ]
  },
  "categories": [
    { "id": "mission",       "label": "Missão",       "color": "#a855f7", "shape2D": "hexagon",  "shape3D": "sphere",    "description": "Propósito de mais alto nível do sistema." },
    { "id": "requirement",   "label": "Requisito",    "color": "#2563eb", "shape2D": "document", "shape3D": "flatPanel", "description": "Condição que o sistema deve atender." },
    { "id": "function",      "label": "Função",       "color": "#14b8a6", "shape2D": "rounded",  "shape3D": "capsule",   "description": "Capacidade lógica que o sistema executa." },
    { "id": "subsystem",     "label": "Subsistema",   "color": "#22c55e", "shape2D": "group",    "shape3D": "box",       "description": "Bloco físico/lógico principal do satélite." },
    { "id": "component",     "label": "Componente",   "color": "#eab308", "shape2D": "box",      "shape3D": "smallBox",  "description": "Elemento dentro de um subsistema." },
    { "id": "verification",  "label": "Verificação",  "color": "#ef4444", "shape2D": "check",    "shape3D": "diamond",   "description": "Atividade que comprova requisito atendido." }
  ],
  "relationTypes": [
    { "id": "satisfies",                "index": 1, "label": "Satisfaz requisito",   "color": "#2563eb", "lineStyle": "solid",  "directed": true,  "description": "Indica que uma função, subsistema ou componente satisfaz um requisito." },
    { "id": "allocated_to",             "index": 2, "label": "Alocado para",         "color": "#14b8a6", "lineStyle": "dashed", "directed": true,  "description": "Indica alocação de requisito ou função para um elemento físico ou lógico." },
    { "id": "provides_power_to",        "index": 3, "label": "Fornece potência",     "color": "#f59e0b", "lineStyle": "solid",  "directed": true,  "description": "Indica fornecimento de energia elétrica entre subsistemas ou componentes." },
    { "id": "sends_data_to",            "index": 4, "label": "Envia dados",          "color": "#06b6d4", "lineStyle": "solid",  "directed": true,  "description": "Indica fluxo de dados, telemetria ou payload data." },
    { "id": "receives_command_from",    "index": 5, "label": "Recebe comando",       "color": "#8b5cf6", "lineStyle": "dotted", "directed": true,  "description": "Indica fluxo de telecomando." },
    { "id": "mechanically_attached_to", "index": 6, "label": "Fixação mecânica",     "color": "#64748b", "lineStyle": "solid",  "directed": false, "description": "Indica acoplamento ou fixação estrutural." },
    { "id": "thermally_coupled_to",     "index": 7, "label": "Acoplamento térmico",  "color": "#dc2626", "lineStyle": "dashed", "directed": false, "description": "Indica troca ou acoplamento térmico relevante." },
    { "id": "verifies",                 "index": 8, "label": "Verifica",             "color": "#16a34a", "lineStyle": "solid",  "directed": true,  "description": "Indica que uma verificação confirma o atendimento de um requisito." }
  ],
  "entities": [
    { "id": "mission",      "name": "Missão DemoSat",                "category": "mission",      "step": 1, "description": "Missão conceitual de observação da Terra com satélite de 30 kg em órbita baixa." },

    { "id": "req_image",    "name": "REQ-001 · Capturar imagem",     "category": "requirement",  "step": 3, "description": "O sistema deve capturar imagens multiespectrais da superfície terrestre com GSD ≤ 20 m." },
    { "id": "req_downlink", "name": "REQ-002 · Transmitir dados",    "category": "requirement",  "step": 3, "description": "O sistema deve transmitir dados de missão para a estação solo via S-Band a ≥ 2 Mbps." },
    { "id": "req_power",    "name": "REQ-003 · Autonomia elétrica",  "category": "requirement",  "step": 3, "description": "O EPS deve manter o satélite operacional em eclipse por pelo menos 35 minutos." },
    { "id": "req_thermal",  "name": "REQ-004 · Faixa térmica",       "category": "requirement",  "step": 3, "description": "Eletrônica deve operar dentro de -10 °C a +40 °C em todos os modos." },

    { "id": "func_capture", "name": "Capturar imagem",               "category": "function",     "step": 4, "description": "Aquisição de imagem multiespectral pelo payload óptico." },
    { "id": "func_transmit","name": "Transmitir dados",              "category": "function",     "step": 4, "description": "Envio de dados de missão e telemetria ao segmento solo." },
    { "id": "func_command", "name": "Receber telecomando",           "category": "function",     "step": 4, "description": "Recebimento e validação de comandos vindos do solo." },
    { "id": "func_pwr_mgmt","name": "Gerenciar energia",             "category": "function",     "step": 4, "description": "Geração, armazenamento e distribuição de energia elétrica." },
    { "id": "func_thermal", "name": "Controlar temperatura",         "category": "function",     "step": 4, "description": "Manter a faixa térmica dos componentes críticos." },

    { "id": "payload",      "name": "Payload Óptico",                "category": "subsystem",    "subsystem": "Payload",    "step": 6, "description": "Carga útil responsável pela aquisição de imagens.",            "budgets": [{ "kind": "mass", "allocated": 6.0, "estimated": 5.6, "unit": "kg" }, { "kind": "power", "allocated": 22, "estimated": 18, "unit": "W" }] },
    { "id": "eps",          "name": "EPS · Subsistema de Potência",  "category": "subsystem",    "subsystem": "EPS",        "step": 6, "description": "Painéis solares, bateria de íons de lítio e PCDU regulando 28 V.", "budgets": [{ "kind": "mass", "allocated": 4.0, "estimated": 3.2, "unit": "kg" }, { "kind": "power", "allocated": 60, "estimated": 56, "unit": "W" }] },
    { "id": "obc",          "name": "OBC · Computador de Bordo",     "category": "subsystem",    "subsystem": "OBC",        "step": 6, "description": "Computador principal, mass memory e FDIR software.",              "budgets": [{ "kind": "mass", "allocated": 1.5, "estimated": 1.1, "unit": "kg" }, { "kind": "power", "allocated": 9, "estimated": 7, "unit": "W" }] },
    { "id": "ttc",          "name": "TT&C · Comunicações",           "category": "subsystem",    "subsystem": "TTC",        "step": 6, "description": "Transceptor S-Band, diplexer e antena para uplink/downlink.",      "budgets": [{ "kind": "mass", "allocated": 1.8, "estimated": 1.4, "unit": "kg" }, { "kind": "power", "allocated": 14, "estimated": 12, "unit": "W" }] },
    { "id": "adcs",         "name": "ADCS · Controle de Atitude",    "category": "subsystem",    "subsystem": "ADCS",       "step": 6, "description": "Star tracker, sun sensors, IMU, reaction wheels e magnetorquers.", "budgets": [{ "kind": "mass", "allocated": 3.5, "estimated": 2.8, "unit": "kg" }, { "kind": "power", "allocated": 12, "estimated": 10, "unit": "W" }] },
    { "id": "thermal",      "name": "Subsistema Térmico",            "category": "subsystem",    "subsystem": "THERMAL",    "step": 6, "description": "Radiadores, MLI e heaters para controle térmico passivo/ativo.",    "budgets": [{ "kind": "mass", "allocated": 2.0, "estimated": 1.7, "unit": "kg" }, { "kind": "power", "allocated": 8,  "estimated": 6,  "unit": "W" }] },
    { "id": "structure",    "name": "Estrutura",                     "category": "subsystem",    "subsystem": "STRUCTURE",  "step": 6, "description": "Estrutura mecânica primária do satélite em alumínio aeroespacial.","budgets": [{ "kind": "mass", "allocated": 6.0, "estimated": 5.9, "unit": "kg" }] },

    { "id": "solar_array",  "name": "Painéis solares",               "category": "component",    "parentId": "eps",     "subsystem": "EPS",       "step": 7, "description": "Geração primária de energia, 4 painéis de GaAs triple-junction." },
    { "id": "battery",      "name": "Bateria Li-ion",                "category": "component",    "parentId": "eps",     "subsystem": "EPS",       "step": 7, "description": "Armazenamento de energia para operação durante eclipse." },
    { "id": "pcdu",         "name": "PCDU",                          "category": "component",    "parentId": "eps",     "subsystem": "EPS",       "step": 7, "description": "Unidade de controle e distribuição de potência (barramento regulado de 28 V)." },
    { "id": "camera",       "name": "Câmera multiespectral",         "category": "component",    "parentId": "payload", "subsystem": "Payload",   "step": 7, "description": "Sensor principal da missão, 6 bandas espectrais, GSD 20 m." },
    { "id": "antenna",      "name": "Antena S-Band",                 "category": "component",    "parentId": "ttc",     "subsystem": "TTC",       "step": 7, "description": "Antena patch dual-polarização para uplink e downlink." },
    { "id": "rw_set",       "name": "Reaction wheels (3)",           "category": "component",    "parentId": "adcs",    "subsystem": "ADCS",      "step": 7, "description": "Conjunto de 3 reaction wheels para controle 3-eixos." },

    { "id": "ver_image_test", "name": "Teste funcional de imagem",   "category": "verification", "step": 10, "description": "Teste funcional do payload em câmara para verificar aquisição da imagem.",                "status": "planned",     "metadata": { "method": "Test",     "level": "Subsystem" } },
    { "id": "ver_downlink",   "name": "Teste de downlink",           "category": "verification", "step": 10, "description": "Teste end-to-end de downlink S-Band com a estação solo.",                                  "status": "in_progress", "metadata": { "method": "Test",     "level": "System" } },
    { "id": "ver_thermal",    "name": "Análise térmica",             "category": "verification", "step": 10, "description": "Análise térmica em pior caso (eclipse longo / iluminação máxima) para validar a faixa.", "status": "passed",      "metadata": { "method": "Analysis", "level": "Subsystem" } },
    { "id": "ver_power",      "name": "Teste em vácuo térmico (EPS)","category": "verification", "step": 10, "description": "Teste de capacidade da bateria em ciclos eclipse/sol com cargas representativas.",         "status": "planned",     "metadata": { "method": "Test",     "level": "Subsystem" } }
  ],
